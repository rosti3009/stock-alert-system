API_PROVIDER=polygon
API_KEY=your_api_key_here

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SCAN_MODE=daily
USE_DYNAMIC_SYMBOLS=true
MAX_SYMBOLS_PER_SCAN=30
MIN_PRICE=5
MIN_AVG_VOLUME=500000
BATCH_SIZE=5
REQUEST_DELAY_SECONDS=1
SCAN_SYMBOL_TIMEOUT_SECONDS=45
DAILY_SCAN_HOUR=23
DAILY_SCAN_MINUTE=30
SCAN_INTERVAL_MINUTES=30
RUN_SCAN_ON_STARTUP=false

MAX_RISK_PERCENT=8
MIN_RR_RATIO=2
STOP_LOSS_BUFFER=0.98
ATR_STOP_MULTIPLIER=1.5
MAX_SLIPPAGE_ESTIMATE=2.0

RSI_BUY_MIN=50
RSI_BUY_MAX=70
RSI_SELL_MAX=45
BUY_TELEGRAM_MIN_SCORE=75
SELL_TELEGRAM_MIN_SCORE=70
ALERT_COOLDOWN_MINUTES=240

DB_PATH=stock_alerts.db

# Live position tracking
POSITION_TRACK_INTERVAL_SECONDS=15
SWING_POSITION_TRACK_INTERVAL_SECONDS=60
WATCHDOG_POSITION_TRACKING_STALE_SECONDS=60

# Position limit / capital allocation
POSITION_LIMIT_MODE=CAPITAL_BASED
MAX_OPEN_POSITIONS=10
SWING_CAPITAL_PERCENT=50
INTRADAY_CAPITAL_PERCENT=40
RESERVE_CAPITAL_PERCENT=10
MIN_POSITION_SIZE_USD=500
MAX_TOTAL_EXPOSURE_PERCENT=90
MAX_POSITION_PERCENT=10
MAX_DAILY_LOSS_PERCENT=5
IBKR_PAPER_TRADING=true
IBKR_ENABLE_REAL_TRADING=false

# Local IBKR Gateway push agent
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17
RENDER_API_URL=https://stock-alert-system-moit.onrender.com
BROKER_PUSH_TOKEN=change-me
BROKER_PUSH_INTERVAL_SECONDS=15
BROKER_SNAPSHOT_MAX_AGE_SECONDS=60
